knitr::opts_chunk$set(echo = TRUE)
# Turn off scientific notation
options(scipen=999)
# Load the tidyverse. If you have not installed the tidyverse already, remove the # from the next line and run it first.
# install.packages('tidyverse')
library(tidyverse)
library(lubridate)
umd_courses <- read_rds("data/umd_courses.rds")
maryland_expenses <- read_csv("data/maryland_expenses.csv")
View(maryland_expenses)
View(umd_courses)
courses_on_climate <- umd_courses |>
filter(title == "Theatre") |>
filter(seats >= 1)
View(courses_on_climate)
View(courses_on_climate)
courses_on_climate <- umd_courses |>
filter(title == "climate") |>
filter(seats >= 1)
View(courses_on_climate)
View(courses_on_climate)
View(courses_on_climate)
View(courses_on_climate)
View(umd_courses)
courses_on_climate_min_1 <- umd_courses |> filter(department == "Climate" & seats >= 1)
nrow(courses_on_climate_min_1)
View(courses_on_climate)
View(umd_courses)
courses_on_climate_min_1 <- umd_courses |> filter(title == "Climate" & seats >= 1)
nrow(courses_on_climate_min_1)
courses_on_climate_min_1 <- umd_courses |>
filter(str_detect(title, "Climate") & seats >= 1)
View(courses_on_climate_min_1)
courses_on_climate_min_1 <- umd_courses |>
filter(str_detect(title, "Climate") & seats >= 1)  |>
climate_by_dept <- courses_on_climate_min_1  |>
group_by(department) |>
summarize(course_count = n()) |>
arrange(desc(course_count))
climate_by_dept <- courses_on_climate_min_1  |>
group_by(department) |>
summarize(course_count = n()) |>
arrange(desc(course_count))
View(climate_by_dept)
View(courses_on_climate_min_1)
View(climate_by_dept)
View(climate_by_dept)
View(umd_courses)
knitr::opts_chunk$set(echo = TRUE)
maryland_expenses <- maryland_expenses |> mutate(expenditure_date=mdy(expenditure_date))
head(maryland_expenses)
